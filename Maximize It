import itertools
K, M = map(int, input().split())
lists = []
for _ in range(K):
    lists.append(list(set(map(lambda x: int(x)**2 % M, input().split()[1:]))))
max_val = 0
for combination in itertools.product(*lists):
    current_val = sum(combination) % M
    if current_val > max_val:
        max_val = current_val

print(max_val)
