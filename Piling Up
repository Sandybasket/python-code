from collections import deque

def solve():
    try:
        line1 = input().split()
        if not line1: return
        n = int(line1[0])
        cubes = deque(map(int, input().split()))
    except EOFError:
        return

    last_placed = float('inf')
    possible = True
    
    while cubes:
        if cubes[0] >= cubes[-1]:
            current = cubes.popleft()
        else:
            current = cubes.pop()
        

        if current > last_placed:
            possible = False
            break
        last_placed = current
        
    if possible:
        print("Yes")
    else:
        print("No")

t = int(input())
for _ in range(t):
    solve()
