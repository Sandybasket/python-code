import sys
def main():
    try:
        line = sys.stdin.readline()
        if not line:
            return
        t = int(line.strip())
    except ValueError:
        return
    for _ in range(t):
        try:
            a, b = sys.stdin.readline().split()
            print(int(a) // int(b))
        except (ZeroDivisionError, ValueError) as e:
            print("Error Code:", e)
if __name__ == "__main__":
    main()
